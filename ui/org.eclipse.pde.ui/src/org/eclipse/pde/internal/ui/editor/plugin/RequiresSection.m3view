# View template spec (brief rule 27) of a PDE form section: rows come from the editor model; the pde-model adapter
# (org.eclipse.pde.internal.ui.editor.m3.M3ModelChangedDeltas) answers IModelChangedEvent with one delta.
view.id=org.eclipse.pde.internal.ui.editor.plugin.RequiresSection
element=ImportObject
source=pde-model
lanes=order:int, id:label, version:label, optional:bits, reexport:bits
group=none
sort=order
presentation=table
label=PDELabelProvider
